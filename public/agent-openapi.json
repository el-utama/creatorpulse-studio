{
  "openapi": "3.1.0",
  "info": {
    "title": "CreatorPulse Agent Gateway",
    "version": "3.5.0",
    "description": "Single workspace, max three accounts. Inbox and human-approved Direct Post according to TikTok permissions. Agent-supplied trend observations are not verified live rankings. Gateway v1 is independent of the dashboard redesign. Health indicates configuration completeness, not storage reachability. Authenticated agent calls are limited to 60 per fixed minute; operator calls are exempt."
  },
  "servers": [
    {
      "url": "https://creatorpulse-studio-six.vercel.app/api/gateway/v1"
    }
  ],
  "security": [
    {
      "agentBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "agentBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Configuration completeness (not a connectivity probe)",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required or TikTok session expired"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or approval required"
          },
          "502": {
            "description": "Upstream failure"
          },
          "503": {
            "description": "Gateway not configured or storage unavailable"
          }
        }
      }
    },
