    "/posts/{postId}/approve": {
      "post": {
        "operationId": "approvePost",
        "summary": "Human-only approval; never provide operator credential to agent",
        "security": [
          {
            "operatorBearer": []
          }
        ],
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "accountId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "videoUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "inbox",
                      "profile"
                    ]
                  },
                  "confirm": {
                    "type": "boolean",
                    "const": true
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "approvedCaption": {
                    "type": "string",
                    "maxLength": 2200
                  },
                  "direct": {
                    "type": "object",
                    "properties": {
                      "privacy": {
                        "enum": [
                          "SELF_ONLY",
                          "PUBLIC_TO_EVERYONE",
                          "FOLLOWER_OF_CREATOR",
                          "MUTUAL_FOLLOW_FRIENDS"
                        ]
                      },
                      "musicConsent": {
                        "const": true
                      },
                      "policyConsent": {
                        "const": true
                      },
                      "disableComment": {
                        "type": "boolean"
                      },
                      "disableDuet": {
                        "type": "boolean"
                      },
                      "disableStitch": {
                        "type": "boolean"
                      },
                      "brandOrganic": {
                        "type": "boolean"
                      },
                      "brandContent": {
                        "type": "boolean"
                      },
                      "isAigc": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "privacy",
                      "musicConsent",
                      "policyConsent",
                      "disableComment",
                      "disableDuet",
                      "disableStitch",
                      "brandOrganic",
                      "brandContent",
                      "isAigc"
                    ]
                  }
                },
                "required": [
                  "accountId",
                  "videoUrl",
                  "caption",
                  "mode",
                  "confirm"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "const": "profile"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "duration",
                        "approvedCaption",
                        "direct"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required or TikTok session expired"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or approval required"
          },
          "502": {
            "description": "Upstream failure"
          },
          "503": {
            "description": "Gateway not configured or storage unavailable"
          }
        }
