      "post": {
        "operationId": "recordTrend",
        "summary": "Save a sourced observation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "topic",
                      "hashtag",
                      "music",
                      "video",
                      "keyword"
                    ]
                  },
                  "region": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "tiktok_creative_center",
                      "tiktok_discovery_api",
                      "google_trends",
                      "web_research",
                      "manual"
                    ]
                  },
                  "sourceUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "changePct": {
                    "type": "number"
                  },
                  "metric": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic",
                  "type",
                  "region",
                  "source",
                  "sourceUrl",
                  "observedAt",
                  "evidence"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required or TikTok session expired"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or approval required"
          },
          "429": {
            "description": "Authenticated agent rate limit exceeded"
          },
          "502": {
            "description": "Upstream failure"
          },
          "503": {
            "description": "Gateway not configured or storage unavailable"
          }
        }
      }
