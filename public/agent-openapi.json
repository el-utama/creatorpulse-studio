          }
        }
      },
      "post": {
        "operationId": "preparePost",
        "summary": "Create immutable inbox or Direct Post draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "accountId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "videoUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 2200
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "inbox",
                      "profile"
                    ]
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Required for profile; seconds"
                  }
                },
                "required": [
                  "requestId",
                  "accountId",
                  "videoUrl",
                  "caption",
                  "mode"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "mode": {
                          "const": "profile"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "duration"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required or TikTok session expired"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict or approval required"
          },
          "429": {
            "description": "Authenticated agent rate limit exceeded"
          },
          "502": {
            "description": "Upstream failure"
          },
          "503": {
            "description": "Gateway not configured or storage unavailable"
          }
        }
      }
    },
